[user]
  name = Oğulcan Girginç
  email = ogulcan@girginc.com

[init]
  defaultBranch = main

[core]
  editor = nvim
  commentChar = ";"
  pager = delta --paging=never

[push]
  autoSetupRemote = true
	default = current

[alias]
  sb   = "!f() { git switch $(git branch | fzf --height 40% --reverse --border); }; f"
  srb  = "!f() { git switch -t $(git branch -r | fzf --height 40% --reverse --border); }; f"
  ssb  = "!f() { git add . && git stash && git switch $(git branch | fzf --height 40% --reverse --border) && git stash pop; }; f"
  sc   = "!f() { if e=$(git switch -c \"$1\" 2>&1); then echo \"$e\" >&2; elif echo \"$e\" | grep -q 'already exists'; then git switch \"$1\"; else echo \"$e\" >&2; return 1; fi; }; f"

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[commit]
  verbose = true

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictStyle = zdiff3

[rebase]
  updateRefs = true

[diff]
  colorMoved = default

[delta]
	navigate = true
  side-by-side = true
  dark = true
  true-color = always
